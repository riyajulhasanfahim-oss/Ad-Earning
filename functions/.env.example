# Firebase Cloud Functions v2 Backend Environment Variables
# Copy this file to functions/.env (never commit functions/.env) before deploying,
# or configure these keys in your Cloud Functions runtime environment.
# NEVER expose Secret Keys or Private API Keys in frontend VITE_* variables.

APPLIXIR_SITE_ID=""
APPLIXIR_API_KEY=""
APPLIXIR_SECRET_KEY=""

POSTBACK_SECRET="CHANGE_ME_IN_FIREBASE_SECRET_MANAGER"
ENFORCE_APP_CHECK="false"
